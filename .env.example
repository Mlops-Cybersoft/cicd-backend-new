ENVIRONMENT=development
DATABASE_DRIVER=postgresql+psycopg
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=documind
DATABASE_USER=documind
DATABASE_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=["http://localhost:3000"]

# Amazon S3. Create the private bucket before starting the API.
# Leave credentials blank when using an IAM role or the standard AWS credential chain.
S3_ENDPOINT_URL=
S3_REGION=ap-southeast-1
S3_BUCKET=replace-with-your-private-bucket-name
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_USE_SSL=true

# OpenAI embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Required for embeddings; also enables generated RAG answers.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini

SEED_DEMO_DATA=true
DEMO_PASSWORD=ChangeMe123!
